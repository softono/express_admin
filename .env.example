# App
APP_NAME=My App
APP_UID=my-app
APP_LOGO=logo.png
APP_TIMEZONE=UTC

# Frontend origin — used in email links and OAuth final redirects
BASE_URL=http://localhost:5174
# Own origin — used to build file URLs
API_URL=http://localhost:4001
PORT=4001

# Server
NODE_ENV=development
APP_ENV=development
APP_DEBUG=true
CORS_ORIGIN=${BASE_URL}

# 32 character
ENCRYPTION_KEY="secret-key"

# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname

# Cache (memory | redis | sqlite)
CACHE_DRIVER=sqlite
REDIS_URL=127.0.0.1:6379
# SQLite cache file (used when CACHE_DRIVER=sqlite)
CACHE_SQLITE_PATH=./storage/cache/cache.sqlite

# Filesystem (local | s3)
FILESYSTEM_DISK=local
#Local storage (required when FILESYSTEM_DISK=local)
FILESYSTEM_PATH=./upload
FILESYSTEM_URL=${API_URL}/upload
#FILESYSTEM_URL="https://${AWS_REGION}.s3.amazonaws.com/${AWS_BUCKET}"

# S3 / AWS (required when FILESYSTEM_DISK=s3)
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3-compatible endpoint, e.g. http://localhost:9000 for MinIO (optional)
AWS_ENDPOINT=

IMGPROXY_ENABLED=false
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_URL="https://img.example.com"

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=${BASE_URL}
